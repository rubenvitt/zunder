  {
    "annotations": {
      "openWorldHint": false,
      "readOnlyHint": true,
      "title": "Aufgaben filtern"
    },
    "description": "Listet Aufgaben nach Filtern. Ohne include_closed werden erledigte und verworfene Aufgaben ausgeblendet, deren Status sich vor mehr als 3 Tagen geändert hat. Gelöschte Aufgaben erscheinen nie. Alle Filter werden mit UND verknüpft. Sortierung: Fälligkeit (ohne Fälligkeit zuletzt), dann Erstellung.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "area_id": {
          "description": "Nur Aufgaben in diesem Bereich, direkt oder in einem seiner Projekte.",
          "type": "string"
        },
        "claimed_by": {
          "description": "Nur Aufgaben mit gültiger Reservierung durch diesen Agenten.",
          "type": "string"
        },
        "due_after": {
          "description": "Fällig frühestens an diesem Tag (JJJJ-MM-TT oder RFC 3339, inklusive, Vergleich nach Kalendertag).",
          "type": "string"
        },
        "due_before": {
          "description": "Fällig spätestens an diesem Tag (JJJJ-MM-TT oder RFC 3339, inklusive, Vergleich nach Kalendertag).",
          "type": "string"
        },
        "include_closed": {
          "description": "Auch erledigte und verworfene Aufgaben, die älter als 3 Tage sind (Standard false).",
          "type": "boolean"
        },
        "limit": {
          "default": 100,
          "description": "Höchstzahl der Ergebnisse.",
          "maximum": 500,
          "minimum": 1,
          "type": "integer"
        },
        "location": {
          "description": "Art der wirksamen Stelle (bei Unteraufgaben die der Wurzelaufgabe).",
          "enum": [
            "inbox",
            "loose",
            "area",
            "project"
          ],
          "type": "string"
        },
        "parent_id": {
          "description": "Nur direkte Unteraufgaben dieser Aufgabe.",
          "type": "string"
        },
        "phoenix_fire": {
          "description": "Nur Aufgaben dieses Feuers (ISO-Woche JJJJ-Www).",
          "type": "string"
        },
        "phoenix_role": {
          "description": "Nur Aufgaben mit dieser Phönix-Rolle.",
          "enum": [
            "feuer_schritt",
            "flamme"
          ],
          "type": "string"
        },
        "project_id": {
          "description": "Nur Aufgaben in diesem Projekt.",
          "type": "string"
        },
        "status": {
          "description": "Nur diese Status.",
          "items": {
            "enum": [
              "open",
              "in_progress",
              "review",
              "blocked",
              "done",
              "dropped"
            ],
            "type": "string"
          },
          "type": "array"
        },
        "type": {
          "description": "Nur diese Typen.",
          "items": {
            "enum": [
              "aufgabe",
              "bug",
              "feature"
            ],
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [],
      "type": "object"
    },
    "name": "filter_tasks",
    "title": "Aufgaben filtern"
  },

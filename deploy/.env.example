# Zunder – .env.example (VORLAGE, enthält keine echten Werte)
#
# Nicht direkt befüllen. ./generate-secrets.sh liest diese Vorlage und
# schreibt das Ergebnis nach .env (von git ignoriert, Rechte 600), die
# compose.yaml per env_file lädt. Statische Werte stehen in compose.yaml.
#
# Platzhalter:
#   WILL_BE_GENERATED  wird vom Skript zufällig erzeugt
#   CHANGEME_MANUAL    wird vom Skript abgefragt
#   CHANGEME_OPTIONAL  wird abgefragt, darf leer bleiben (leer = Funktion aus)

# Pocket-ID (MANUAL) – OIDC-Client in Pocket-ID anlegen,
# Callback-URL: https://zunder.rubeen.dev/auth/callback
ZUNDER_OIDC_ISSUER=CHANGEME_MANUAL
ZUNDER_OIDC_CLIENT_ID=CHANGEME_MANUAL
ZUNDER_OIDC_CLIENT_SECRET=CHANGEME_MANUAL
# Die eine Person, die sich anmelden darf (E-Mail des Pocket-ID-Kontos)
ZUNDER_OIDC_ALLOWED_EMAIL=CHANGEME_MANUAL

# Sitzungen (GENERATED)
ZUNDER_SESSION_SECRET=WILL_BE_GENERATED

# Timing-Web-API (OPTIONAL) – API-Token aus Timing; Ziel-Projekt als
# Self-Link (/projects/<id>) oder Projekttitel, keine reine Zahl
ZUNDER_TIMING_TOKEN=CHANGEME_OPTIONAL
ZUNDER_TIMING_PROJECT=CHANGEME_OPTIONAL
